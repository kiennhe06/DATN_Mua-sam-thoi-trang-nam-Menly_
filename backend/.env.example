PORT=5000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend dùng service role key ở phía server khi không có anon key.
# Không đưa service role key vào Git, admin hoặc app Flutter.

# Chế độ đăng nhập demo/local fallback (tài khoản mẫu, token demo-access/ui-preview).
# Chỉ hoạt động khi NODE_ENV != production. Đặt DEMO_AUTH_ENABLED=false để tắt cả ở dev.
# Production luôn tắt để tránh backdoor, không cần đặt biến này.
DEMO_AUTH_ENABLED=true

# VNPay (BẮT BUỘC khi bật thanh toán online — không còn giá trị mặc định hardcode).
# Thiếu hai khóa dưới đây thì checksum thanh toán sẽ không hợp lệ.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=

# Khoa Gemini cho chuc nang chat AI, lay tai https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bảng giá giao hàng (đơn vị: đồng). Bỏ trống thì dùng giá mặc định bên dưới.
# App và web admin đọc bảng giá này qua API /api/v1/orders/shipping-policy,
# nên đổi giá chỉ cần sửa ở đây rồi khởi động lại máy chủ.
SHIPPING_STANDARD_FEE=25000
SHIPPING_EXPRESS_FEE=45000
SHIPPING_FREE_THRESHOLD=399000
